# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon Postgres connection string for a DEDICATED READ-ONLY ROLE.
# Do NOT use the loader/owner role. The CREATE ROLE / GRANT SQL is in the README.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_READONLY_URL=

# For the one-time schema introspection only. May be the owner/loader role,
# since introspection needs to read pg_catalog and all table DDL. Optional:
# if unset, introspection falls back to NEON_READONLY_URL.
NEON_INTROSPECT_URL=

# Per-session statement timeout in milliseconds. Applied to every connection.
STATEMENT_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Max tool calls the agent may make in a single conversational turn.
MAX_TOOL_CALLS_PER_TURN=10

# ---------------------------------------------------------------------------
# Existing FastAPI service on Render (for endpoint inventory / optional reuse)
# ---------------------------------------------------------------------------
# Base URL, no trailing slash, e.g. https://your-service.onrender.com
EXISTING_API_BASE_URL=

# Bearer token for the above, if it requires auth.
EXISTING_API_BEARER_TOKEN=
