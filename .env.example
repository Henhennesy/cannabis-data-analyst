# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon Postgres connection string for the DEDICATED READ-ONLY ROLE.
# Do NOT use the loader/owner role: the agent executes model-generated SQL, and
# privilege is the only real backstop. A role created through the Neon CONSOLE
# is NOT read-only -- it inherits neon_superuser, which carries
# pg_write_all_data. Create it via SQL; the CREATE ROLE / GRANT block and a
# verification script are in the README.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
NEON_READONLY_URL=

# Schema introspection and data loads only -- never the running app. May be the
# owner/loader role, since introspection reads pg_catalog and every table's DDL.
# If unset, introspection falls back to NEON_READONLY_URL.
NEON_INTROSPECT_URL=

# Per-session statement timeout in milliseconds, applied to every connection.
# 8s is deliberate: every tool query fits well inside it once routed through the
# materialized views, and it is the guard on the run_sql escape hatch. Raise it
# only on evidence that real questions are timing out.
STATEMENT_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# From console.anthropic.com -> Settings -> API Keys. Starts with sk-ant-api03-.
# Billed separately from any Claude.ai subscription: the account needs prepaid
# credits under Billing or every request fails with a credit-balance error.
ANTHROPIC_API_KEY=

# claude-opus-5 is the default: this agent's failure mode is a rule-dense system
# prompt being followed imprecisely, and a wrong number reaches a client deck.
# claude-sonnet-5 is the cheaper option if spend becomes the constraint.
ANTHROPIC_MODEL=claude-opus-5

# Thinking depth and overall token spend: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=high

# Max tool calls the agent may make in a single conversational turn.
MAX_TOOL_CALLS_PER_TURN=10

# ---------------------------------------------------------------------------
# Existing FastAPI service on Render (endpoint inventory / reference only)
# ---------------------------------------------------------------------------
# Not used by the running app -- the agent queries Neon directly, because the
# service cannot return the exact SQL the envelope contract requires and caps
# results at 1000 rows. Kept for the inventory script and manual comparison.
# Base URL, no trailing slash, e.g. https://your-service.onrender.com
EXISTING_API_BASE_URL=

# NOTE: this service authenticates with an `x-api-key` HEADER, not a bearer
# token. The variable name is kept for compatibility with the original spec.
EXISTING_API_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Connection pool (optional -- defaults shown)
# ---------------------------------------------------------------------------
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ---------------------------------------------------------------------------
# Deployment (docker compose only -- not needed to run locally)
# ---------------------------------------------------------------------------
# Cloudflare Tunnel token. Zero Trust dashboard -> Networks -> Tunnels ->
# create a tunnel -> the Docker command it shows you ends in `--token eyJh...`.
# Copy just the token.
#
# TREAT THIS LIKE A PASSWORD. Anyone holding it can register as your tunnel and
# receive the traffic for your hostname. It is not protected by Access -- Access
# guards the front door, this token IS the back door.
TUNNEL_TOKEN=

# Where the saved-analyses SQLite file lives. Left unset locally, where it
# defaults to backend/data/analyses.sqlite. docker-compose.yml sets it to
# /data/analyses.sqlite, which is the mounted volume.
ANALYSES_DB_PATH=
