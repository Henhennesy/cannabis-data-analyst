# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Local caches / logs produced at runtime
# The sidecars matter too: SQLite runs in WAL mode, so the -wal and -shm files
# hold committed rows the .sqlite file does not yet contain.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
backend/cache/
backend/logs/

# reports/ IS tracked on purpose: the schema report is a milestone deliverable
# and diffing it against next month's data load is how we spot schema drift.

# OS
Thumbs.db
.DS_Store

# Introspection run logs (duplicate of schema_report.md)
reports/*.log

# BDSA data files: large, and the raw exports are licensed vendor data.
# The cleaning/loading CODE is tracked; the data is not.
data_cleaning_tool/raw_exports/
data_cleaning_tool/raw_normalized/
data_cleaning_tool/clean/

# Vite build output
frontend/dist/
